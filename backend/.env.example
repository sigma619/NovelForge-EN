# ==================== Database ====================
# Database file path (optional)
# Default: backend/novelforge.db
# Set an absolute path to customize the database location
# NOVELFORGE_DB_PATH=/path/to/your/database.db
# Legacy alias: AIAUTHOR_DB_PATH

# Knowledge-graph provider (sqlite | neo4j)
KNOWLEDGE_GRAPH_PROVIDER=sqlite

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

ASSISTANT_USE_LANGCHAIN=1

# Max retries when a model tool call fails
MAX_TOOL_CALL_RETRIES=5

# Overwrite built-in data (knowledge base / prompts / workflows) on startup.
# Keep false so user edits to built-in items are not silently reverted;
# missing built-in items are still created regardless of this flag.
BOOTSTRAP_OVERWRITE=false
# Overwrite built-in card schemas (false = keep user-modified schemas)
BOOTSTRAP_OVERWRITE_CARD_SCHEMAS=false

# ==================== Workflow ====================
# Retention (days) for persistent workflow run records, default 7
WORKFLOW_RETENTION_PERSISTENT_DAYS=7
